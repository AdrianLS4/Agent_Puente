# --- PayPal SANDBOX (developer.paypal.com → Apps & Credentials → Sandbox → Create App) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- LLM (OpenAI Agents SDK) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Operación ---
PUENTE_MOCK=1            # 1 = MockPayPal (sin credenciales) · 0 = PayPal sandbox real
PUENTE_DB=./puente.db
MAX_AMOUNT_USD=200
DISPUTE_AUTO_MAX_USD=50

# --- Tasa USD/VES: elige y VERIFICA tu fuente antes del demo ---
FX_URL=
FX_JSON_PATH=rate        # ruta al valor en el JSON, ej. data.promedio
